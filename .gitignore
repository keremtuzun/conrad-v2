__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/
dist/
build/
*.egg-info/
# artifacts are never source authority (ch34). Small tracked ledgers live under artifacts/spec and artifacts/migration.
artifacts/*
!artifacts/spec/
!artifacts/migration/
# gate evidence (small JSON/text written by executed gate tests, e.g. tests/unity_live -> artifacts/gates/U0)
!artifacts/gates/
!artifacts/gates/
!artifacts/experiments/
artifacts/experiments/*/*.checkpoint.json
artifacts/experiments/M1-ACTION-SPATIAL-V1-DEV/diagnostic_*.json
!artifacts/registry/
# truth-removal falsification reports (small JSON, scripts/falsify_truth_removal.py)
!artifacts/falsification/
# flagship demonstration run (small JSON, scripts/run_flagship_unity.py); the per-step trace stays out
!artifacts/flagship/
artifacts/flagship/trace_*.json
!artifacts/README.md
mlruns/
# secrets and machine-local overrides
.env
.env.*
*.pem
*.key
configs/local.yaml
# unity generated
unity/**/Library/
unity/**/Temp/
unity/**/Obj/
unity/**/Logs/
unity/**/Builds/
unity/**/UserSettings/
unity/**/MemoryCaptures/
unity/**/*.csproj
unity/**/*.sln

artifacts/experiments/ID-REHEARSAL-E001/delivery/

# harness-check run bundles: diagnostic output, not gate evidence (511 MB)
artifacts/experiments/I7-UNITY-HARNESS-CHECK/runs/

# I4 energy development run bundles are local replay traces; commit their compact summaries only.
artifacts/experiments/I4-ENERGY-DIAG/I4-ENERGY-DIAG-s*/
